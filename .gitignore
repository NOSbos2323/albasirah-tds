# robots.txt — مستودع GitHub
# يخفي المستودع عن محركات البحث
# (المقالات تُخدَم عبر Cloudflare Worker، لا حاجة لفهرسة المستودع)
# هذا الملف يُستبدل بـ public/robots.txt عند الـ deploy

# ═══════════════════════════════════════════════════════════════
# ملفات تجاهل — يخفي كل شيء ما عدا المقالات
# ═══════════════════════════════════════════════════════════════
# الاستراتيجية:
# - المقالات في articles/ فقط تُرفع لـ GitHub
# - كل شيء آخر (Worker, PDF, scripts, إعدادات) يبقى محليًا
# - تُرفع لـ Cloudflare فقط عند npx wrangler deploy

# ━━━━ إخفاء كود Worker (يبقى محليًا، يُرفع لـ Cloudflare فقط) ━━━━
/src/
/wrangler.toml
/package.json
/package-lock.json
/yarn.lock
/pnpm-lock.yaml
/.wrangler/

# ━━━━ إخفاء Static Assets الحساسة (PDF الخبيث، server_dir) ━━━━
/public/
!/public/robots.txt

# ━━━━ إخفاء CNAME (يحتوي على نطاق المشروع) ━━━━
/CNAME

# ━━━━ إخفاء ملفات النظام والإعدادات ━━━━
.DS_Store
*.pem
*.log
.env*
!.env.example

# ━━━━ إخفاء node_modules ━━━━
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ━━━━ إخفاء ملفات التطوير المحلية ━━━━
/coverage
/.next/
/out/
/build
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
server.log
dev.log
dev.out.log
test
prompt

# ━━━━ إخفاء بيانات الـ sandbox ━━━━
/skills/
/db/
/prisma/
/Caddyfile
.zscripts/
/upload/
/tool-results/
/worklog.md
/start-dev.sh
/download/
/scripts/

# ━━━━ ملاحظة: المجلدات المسموح بها (لا تُضاف هنا، تُترك افتراضيًا) ━━━━
# /articles/ ← المقالات (تُرفع لـ GitHub)
# /README.md ← التوثيق
# /robots.txt ← robots.txt الخاص بـ GitHub (يخفي المستودع عن البحث)
