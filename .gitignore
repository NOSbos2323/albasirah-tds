# ═══════════════════════════════════════════════════════════════
# .gitignore محدّث — حماية شاملة
# ═══════════════════════════════════════════════════════════════

# ━━━━ حماية ملفات Git الحساسة ━━━━
/.git/
/.git/config
/.git/HEAD
/.git/
**/.git/

# ━━━━ حماية ملفات البيئة والأسرار ━━━━
.env*
!.env.example
*.env
.env.local
.env.production
.env.development

# ━━━━ حماية مفاتيح SSH و AWS ━━━━
/.ssh/
/.aws/
**/.ssh/
**/.aws/
*.pem
*.key
*.cert

# ━━━━ حماية ملفات الإعدادات الحساسة ━━━━
/.htaccess
/.htpasswd
/wp-config.php
/wp-config.php.bak
/config.json
/config.xml
/secret*
/server.key
/composer.json
/package-lock.json
/yarn.lock
/.npmrc
/.docker/
/Dockerfile
/.gitlab-ci.yml
/.github/
/jenkins/
/phpinfo.php
/info.php
/test.php
/shell.php
/eval.php
/backup*
*.sql
*.bak
*.old
*.save

# ━━━━ إخفاء كود Worker (يبقى محليًا) ━━━━
/src/
/wrangler.toml
/package.json
/.wrangler/

# ━━━━ إخفاء Static Assets الحساسة ━━━━
/public/

# ━━━━ ملفات النظام والإعدادات ━━━━
.DS_Store
*.log
*.tmp
*.swp
*~
.claude
.z-ai-config
server.log
dev.log
dev.out.log
test
prompt

# ━━━━ بيانات الـ sandbox ━━━━
/skills/
/db/
/prisma/
/Caddyfile
.zscripts/
/upload/
/tool-results/
/worklog.md
/start-dev.sh
/download/
/scripts/

# ━━━━ Node.js ━━━━
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
local-*
.vercel

# ━━━━ المسموح فقط: articles/ ━━━━
# (لا حاجة لإضافة استثناء — articles/ ليس محجوبًا)
